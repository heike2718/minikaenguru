{
  "openapi" : "3.0.3",
  "info" : {
    "title" : "mkbiza-api",
    "description" : "API für die Statistiken des Minikänguru-Wettbewerbs",
    "contact" : {
      "name" : "Heike Winkelvoß",
      "url" : "https://mathe-jung-alt.de",
      "email" : "info@egladil.de"
    },
    "license" : {
      "name" : "MIT License",
      "url" : "https://mit-license.org/"
    },
    "version" : "3.0.0"
  },
  "servers" : [ {
    "url" : "http://localhost:9540",
    "description" : "Auto generated value"
  }, {
    "url" : "http://0.0.0.0:9540",
    "description" : "Auto generated value"
  } ],
  "tags" : [ {
    "name" : "About",
    "description" : "Stellt Informationen über diese API zur Verfügung"
  }, {
    "name" : "Wettbewerbe"
  } ],
  "paths" : {
    "/mkbiza-api/about" : {
      "get" : {
        "tags" : [ "About" ],
        "summary" : "Gibt Infos über die API zurück.",
        "operationId" : "getInfos",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AboutDto"
                }
              }
            }
          },
          "500" : {
            "description" : "Serverfehler",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MessagePayload"
                }
              }
            }
          }
        }
      }
    },
    "/mkbiza-api/wettbewerbe" : {
      "get" : {
        "tags" : [ "Wettbewerbe" ],
        "summary" : "Gibt Minikänguru-Wettbewerbe sowie deren Status und Mediane zurück",
        "operationId" : "getWettbewerbe",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/Wettbewerb"
                  }
                }
              }
            }
          },
          "404" : {
            "description" : "NotFound",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MessagePayload"
                }
              }
            }
          },
          "500" : {
            "description" : "Serverfehler - Details stehen im server.log",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MessagePayload"
                }
              }
            }
          }
        }
      }
    },
    "/mkbiza-api/wettbewerbe/{jahr}" : {
      "get" : {
        "tags" : [ "Wettbewerbe" ],
        "summary" : "Gibt die Gesamtstatistik eines Wettbewerbs zurück",
        "operationId" : "getStatistikWettbewerb",
        "parameters" : [ {
          "name" : "jahr",
          "in" : "path",
          "description" : "Jahr des Wettbewerbs - 4stellige Jahreszahl",
          "required" : true,
          "schema" : {
            "pattern" : "^[\\d]{4}$",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WettbewerbDetails"
                }
              }
            }
          },
          "400" : {
            "description" : "Inputvalidierung schlug fehl",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ConstraintViolationResponse"
                }
              }
            }
          },
          "404" : {
            "description" : "Wettbewerb existsiert nicht oder ist noch nicht beendet",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MessagePayload"
                }
              }
            }
          },
          "500" : {
            "description" : "Serverfehler - Details stehen im server.log",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MessagePayload"
                }
              }
            }
          }
        }
      }
    },
    "/mkbiza-api/wettbewerbe/{jahr}/{klassenstufe}" : {
      "get" : {
        "tags" : [ "Wettbewerbe" ],
        "summary" : "Gibt Aufgaben und Statistik der Klassenstufe eines Wettbewerbs zurück",
        "description" : "Aufgaben und Auswertunsgstatistiken werden nur bei beendeten Wettbewerben gliefert. Unverfängliche Statistiken werden auch im laufenden Wettbewerb geliefert.",
        "operationId" : "getStatistikJahrKlassenstufe",
        "parameters" : [ {
          "name" : "jahr",
          "in" : "path",
          "description" : "Jahr des Wettbewerbs",
          "required" : true,
          "schema" : {
            "pattern" : "^[\\d]{4}$",
            "type" : "string"
          }
        }, {
          "name" : "klassenstufe",
          "in" : "path",
          "description" : "Eins von IKID,EINS,ZWEI - die Klassenstufe.",
          "required" : true,
          "schema" : {
            "$ref" : "#/components/schemas/Klassenstufe"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/KlassenstufeDetails"
                }
              }
            }
          },
          "400" : {
            "description" : "Input-Validierung ging schief."
          },
          "404" : {
            "description" : "Gibt es nicht"
          },
          "500" : {
            "description" : "Serverfehler",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MessagePayload"
                }
              }
            }
          }
        }
      }
    }
  },
