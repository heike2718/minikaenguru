  "tags" : [ {
    "name" : "About",
    "description" : "Stellt Informationen über diese API zur Verfügung"
  }, {
    "name" : "Wettbewerbe"
  } ],
  "paths" : {
    "/mkbiza-api/about" : {
      "get" : {
        "tags" : [ "About" ],
        "summary" : "Gibt Infos über die API zurück.",
        "operationId" : "getInfos",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AboutDto"
                }
              }
            }
          },
          "500" : {
            "description" : "Serverfehler",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MessagePayload"
                }
              }
            }
          }
        }
      }
    },
    "/mkbiza-api/wettbewerbe" : {
      "get" : {
        "tags" : [ "Wettbewerbe" ],
        "summary" : "Gibt die Jahre aller beendeten Minikänguru-Wettbewerbe zurück",
        "operationId" : "getWettbewerbsjahre",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/Wettbewerb"
                  }
                }
              }
            }
          },
          "500" : {
            "description" : "Serverfehler - Details stehen im server.log",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MessagePayload"
                }
              }
            }
          }
        }
      }
    },
    "/mkbiza-api/wettbewerbe/{jahr}" : {
      "get" : {
        "tags" : [ "Wettbewerbe" ],
        "summary" : "Gibt die Statistik eines Wettbewerbs zurück",
        "operationId" : "getStatistikWettbewerb",
        "parameters" : [ {
          "name" : "jahr",
          "in" : "path",
          "description" : "Jahr des Wettbewerbs - 4stellige Jahreszahl",
          "required" : true,
          "schema" : {
            "pattern" : "^[\\d]{4}$",
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WettbewerbDetails"
                }
              }
            }
          },
          "400" : {
            "description" : "Inputvalidierung schlug fehl",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ConstraintViolation"
                }
              }
            }
          },
          "404" : {
            "description" : "Wettbewerb existsiert nicht oder ist noch nicht beendet",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MessagePayload"
                }
              }
            }
          },
          "500" : {
            "description" : "Serverfehler - Details stehen im server.log",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MessagePayload"
                }
              }
            }
          }
        }
      }
    }
  },
