ENV=dev
STAGE=dev

#=============================================================================================#
#        RestClients                                                                          #
#=============================================================================================#

QUARKUS_REST_CLIENT_MJAAPI_URL=http://localhost:9210/mja-api
QUARKUS_REST_CLIENT_MKGATEWAY_URL=http://localhost:9510/mk-gateway

#=============================================================================================#
#       Logging                                                                               #
#=============================================================================================#
QUARKUS_HTTP_ACCESS_LOG_LOG_TO_FILE=false
QUARKUS_LOG_CATEGORY__DE_EGLADIL_MKBIZA_API_INFRASTRUCTURE_FILTERS_SPAROUTEFILTER__LEVEL=DEBUG

#=============================================================================================#
#        _TEST_                                                                               #
#=============================================================================================#

QUARKUS_HTTP_TEST_TIMEOUT=1m

