{
  "name": "domain-data",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "src/app/shared/domain/data/src",
  "projectType": "library",
  "tags": ["type:data"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/src/app/shared/domain/data",
        "main": "src/app/shared/domain/data/src/index.ts",
        "tsConfig": "src/app/shared/domain/data/tsconfig.lib.json",
        "assets": ["src/app/shared/domain/data/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "src/app/shared/domain/data/jest.config.ts"
      }
    }
  }
}
